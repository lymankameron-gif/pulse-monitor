<Window x:Class="PulseMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PulseMonitor.ViewModels"
        Title="Pulse Monitor"
        Height="560"
        Width="820"
        MinHeight="400"
        MinWidth="640"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Loaded="OnLoaded"
        Closing="OnClosing"
        StateChanged="OnStateChanged"
        LocationChanged="OnBoundsChanged"
        SizeChanged="OnBoundsChanged">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
  </Window.Resources>

  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <DockPanel Background="{DynamicResource WindowBackgroundBrush}">
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Margin="12,10,12,0">
      <RadioButton Content="Processes"
                   GroupName="MainNav"
                   Style="{DynamicResource NavTabButtonStyle}"
                   IsChecked="{Binding IsProcessesSelected, Mode=OneWay}"
                   Checked="OnProcessesNavChecked" />
      <RadioButton Content="Settings"
                   GroupName="MainNav"
                   Style="{DynamicResource NavTabButtonStyle}"
                   IsChecked="{Binding IsSettingsSelected, Mode=OneWay}"
                   Checked="OnSettingsNavChecked" />
    </StackPanel>

    <Grid Margin="12">
      <!-- Processes page -->
      <DockPanel Visibility="{Binding IsProcessesSelected, Converter={StaticResource BoolToVis}}">
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">
          <TextBlock VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     Foreground="{DynamicResource PrimaryTextBrush}">
            <Run Text="CPU:" FontWeight="SemiBold" />
            <Run Text="{Binding OverallCpuText, Mode=OneWay}" />
          </TextBlock>
          <TextBlock VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     Foreground="{DynamicResource PrimaryTextBrush}">
            <Run Text="Memory:" FontWeight="SemiBold" />
            <Run Text="{Binding MemoryText, Mode=OneWay}" />
          </TextBlock>
          <TextBox Width="200"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"
                   Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                   ToolTip="Filter by name (and PID when enabled in Settings)" />
          <Button Content="End task"
                  Padding="12,4"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding CanEndTask}"
                  Command="{Binding EndTaskCommand}" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="0,8,0,0"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Text="{Binding StatusText}" />

        <DataGrid x:Name="ProcessGrid"
                  ItemsSource="{Binding VisibleRows}"
                  SelectedItem="{Binding SelectedRow}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="{Binding GridLinesVisibility}"
                  AlternationCount="{Binding AlternationCount}"
                  RowHeaderWidth="0"
                  Sorting="OnSorting">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Name"
                                Binding="{Binding Name}"
                                Width="*"
                                MinWidth="160"
                                SortMemberPath="Name"
                                ElementStyle="{DynamicResource GridText}" />
            <DataGridTextColumn x:Name="PidColumn"
                                Header="PID"
                                Binding="{Binding Pid}"
                                Width="80"
                                SortMemberPath="Pid"
                                ElementStyle="{DynamicResource GridText}" />
            <DataGridTextColumn x:Name="CpuColumn"
                                Header="CPU"
                                Binding="{Binding CpuText}"
                                Width="80"
                                SortMemberPath="CpuPercent"
                                ElementStyle="{DynamicResource GridText}" />
            <DataGridTextColumn x:Name="MemoryColumn"
                                Header="Memory (MB)"
                                Binding="{Binding MemoryText}"
                                Width="110"
                                SortMemberPath="MemoryMb"
                                ElementStyle="{DynamicResource GridText}" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- Settings page -->
      <ScrollViewer VerticalScrollBarVisibility="Auto"
                    Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVis}}">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">
          <TextBlock Text="Settings"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Margin="0,0,0,4" />
          <TextBlock Style="{DynamicResource SettingsHint}"
                     Text="Changes apply immediately and are saved for the next launch." />

          <TextBlock Text="Appearance" Style="{DynamicResource SettingsSectionTitle}" Margin="0,8,0,8" />
          <TextBlock Text="Theme" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Settings.ThemeOptions}"
                    SelectedItem="{Binding Settings.Theme}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <TextBlock Text="Accent color" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Settings.AccentOptions}"
                    SelectedItem="{Binding Settings.AccentColor}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <TextBlock Text="UI font size" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Settings.FontSizeOptions}"
                    SelectedItem="{Binding Settings.FontSize}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <TextBlock Text="Window opacity" Margin="0,0,0,4" />
          <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Slider Width="220"
                    Minimum="0.55"
                    Maximum="1.0"
                    TickFrequency="0.05"
                    IsSnapToTickEnabled="True"
                    Value="{Binding Settings.WindowOpacity, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding Settings.WindowOpacity, StringFormat={}{0:P0}}" />
          </StackPanel>
          <CheckBox Content="Always on top" IsChecked="{Binding Settings.AlwaysOnTop}" />
          <CheckBox Content="Show grid lines" IsChecked="{Binding Settings.ShowGridLines}" />
          <CheckBox Content="Alternating row colors" IsChecked="{Binding Settings.AlternatingRowColors}" />

          <TextBlock Text="Window" Style="{DynamicResource SettingsSectionTitle}" />
          <CheckBox Content="Remember size and position" IsChecked="{Binding Settings.RememberWindowBounds}" />
          <CheckBox Content="Start maximized" IsChecked="{Binding Settings.StartMaximized}" />

          <TextBlock Text="Process list" Style="{DynamicResource SettingsSectionTitle}" />
          <TextBlock Text="Refresh interval (seconds)" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Settings.RefreshIntervalOptions}"
                    SelectedItem="{Binding Settings.RefreshIntervalSeconds}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <TextBlock Text="Columns" Margin="0,4,0,4" Foreground="{DynamicResource SecondaryTextBrush}" />
          <CheckBox Content="Name (always on)" IsChecked="True" IsEnabled="False" />
          <CheckBox Content="PID" IsChecked="{Binding Settings.ShowPidColumn}" />
          <CheckBox Content="CPU" IsChecked="{Binding Settings.ShowCpuColumn}" />
          <CheckBox Content="Memory" IsChecked="{Binding Settings.ShowMemoryColumn}" />
          <TextBlock Text="Memory units" Margin="0,8,0,4" />
          <ComboBox ItemsSource="{Binding Settings.MemoryUnitOptions}"
                    SelectedItem="{Binding Settings.MemoryUnit}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <TextBlock Text="CPU percent decimals" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Settings.CpuDecimalOptions}"
                    SelectedItem="{Binding Settings.CpuDecimals}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <TextBlock Text="Default sort column" Margin="0,0,0,4" />
          <ComboBox ItemsSource="{Binding Settings.SortColumnOptions}"
                    SelectedItem="{Binding Settings.DefaultSortColumn}"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8" />
          <CheckBox Content="Default sort ascending (off = descending)"
                    IsChecked="{Binding Settings.DefaultSortAscending}" />

          <TextBlock Text="Filter" Style="{DynamicResource SettingsSectionTitle}" />
          <CheckBox Content="Case-sensitive name filter" IsChecked="{Binding Settings.FilterCaseSensitive}" />
          <CheckBox Content="Match PID when filter is digits only" IsChecked="{Binding Settings.FilterMatchPid}" />

          <TextBlock Text="Safety" Style="{DynamicResource SettingsSectionTitle}" />
          <CheckBox Content="Confirm before End task" IsChecked="{Binding Settings.ConfirmBeforeEndTask}" />
          <TextBlock Style="{DynamicResource SettingsHint}"
                     Text="When off, End task runs immediately for the selected process (still cannot end Pulse Monitor itself)." />

          <TextBlock Text="Storage" Style="{DynamicResource SettingsSectionTitle}" />
          <TextBlock Style="{DynamicResource SettingsHint}"
                     Text="{Binding Settings.SettingsPath, StringFormat=Saved to: {0}}" />
          <Button Content="Reset to defaults"
                  HorizontalAlignment="Left"
                  Margin="0,4,0,24"
                  Padding="14,6"
                  Command="{Binding Settings.ResetToDefaultsCommand}" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
