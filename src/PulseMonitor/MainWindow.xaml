<Window x:Class="PulseMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PulseMonitor.ViewModels"
        Title="Pulse Monitor"
        Height="560"
        Width="820"
        MinHeight="400"
        MinWidth="640"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource PrimaryTextBrush}">
  <Window.DataContext>
    <vm:MainViewModel />
  </Window.DataContext>

  <DockPanel Margin="12" Background="{StaticResource WindowBackgroundBrush}">
    <StackPanel DockPanel.Dock="Top"
                Orientation="Horizontal"
                Margin="0,0,0,10"
                Background="{StaticResource WindowBackgroundBrush}">
      <TextBlock VerticalAlignment="Center"
                 Margin="0,0,16,0"
                 Foreground="{StaticResource PrimaryTextBrush}">
        <Run Text="CPU:" FontWeight="SemiBold" />
        <Run Text="{Binding OverallCpuText, Mode=OneWay}" />
      </TextBlock>
      <TextBlock VerticalAlignment="Center"
                 Margin="0,0,16,0"
                 Foreground="{StaticResource PrimaryTextBrush}">
        <Run Text="Memory:" FontWeight="SemiBold" />
        <Run Text="{Binding MemoryText, Mode=OneWay}" />
      </TextBlock>
      <TextBox Width="200"
               VerticalAlignment="Center"
               Margin="0,0,12,0"
               Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Filter by name (or PID if digits only)" />
      <Button Content="End task"
              Padding="12,4"
              VerticalAlignment="Center"
              IsEnabled="{Binding CanEndTask}"
              Command="{Binding EndTaskCommand}" />
    </StackPanel>

    <TextBlock DockPanel.Dock="Bottom"
               Margin="0,8,0,0"
               Foreground="{StaticResource SecondaryTextBrush}"
               Text="{Binding StatusText}" />

    <DataGrid ItemsSource="{Binding VisibleRows}"
              SelectedItem="{Binding SelectedRow}"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserAddRows="False"
              CanUserDeleteRows="False"
              CanUserReorderColumns="False"
              SelectionMode="Single"
              SelectionUnit="FullRow"
              HeadersVisibility="Column"
              GridLinesVisibility="Horizontal"
              RowHeaderWidth="0"
              Sorting="OnSorting">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Name"
                            Binding="{Binding Name}"
                            Width="*"
                            MinWidth="160"
                            SortMemberPath="Name"
                            ElementStyle="{StaticResource DarkGridText}" />
        <DataGridTextColumn Header="PID"
                            Binding="{Binding Pid}"
                            Width="80"
                            SortMemberPath="Pid"
                            ElementStyle="{StaticResource DarkGridText}" />
        <DataGridTextColumn Header="CPU"
                            Binding="{Binding CpuText}"
                            Width="80"
                            SortMemberPath="CpuPercent"
                            SortDirection="Descending"
                            ElementStyle="{StaticResource DarkGridText}" />
        <DataGridTextColumn Header="Memory (MB)"
                            Binding="{Binding MemoryMbText}"
                            Width="110"
                            SortMemberPath="MemoryMb"
                            ElementStyle="{StaticResource DarkGridText}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
